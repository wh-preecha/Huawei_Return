# Copy to api/.env on the API host. Do not commit the real file.
# The API process connects to PostgreSQL. The browser never opens the database port.
# Live Postgres is the existing Supabase container on 15432. Port 5432 is the pooler, not this database.
# 8787 is already used by another app. This API listens on 8791.

PGHOST=10.128.19.192
PGPORT=15432
PGDATABASE=huawei_return
PGUSER=hrms
PGPASSWORD=change-me

# Listen address. 127.0.0.1 when nginx on this same machine proxies /Huawei-Return/api/
BIND_HOST=127.0.0.1
API_PORT=8791
API_PREFIX=/Huawei-Return/api

# Optional. Leave empty for same-origin only.
# CORS_ORIGIN=https://10.128.19.191

# Password-reset mail. The live relay is internal Exchange and accepts this sender without a login.
SMTP_HOST=10.128.1.45
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Huawei Return <huawei-return@synnex.co.th>"
APP_PUBLIC_URL=https://10.128.19.191/Huawei-Return
