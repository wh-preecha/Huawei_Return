rules_version = '2';
// Firestore Security Rules — Huawei Return Management System
// ไม่บังคับ: แอปใช้งานได้กับ rules เดิมที่เปิด collection return_cases อยู่แล้ว (บัญชีผู้ใช้เก็บใน return_cases ด้วย)
// วาง rules นี้เพิ่มเมื่อพร้อม เพื่อกันความเสียหายหนัก: ห้ามลบถาวร, ห้ามเขียนรูปแบบผิด, ห้ามแตะ collection อื่น
//
// collection return_cases เก็บ 3 แบบ:
//   - เคสคืนสินค้า (id ทั่วไป)
//   - บัญชีผู้ใช้ id = 'user~' + อีเมล (หรือชื่อผู้ใช้เดิม) — วันสมัครเก็บเป็น acctCreatedAt (ไม่มี createdAt จึงไม่ปนกับ query เคสแบบ orderBy('createdAt'))
//   - รายชื่อบัญชีทั้งหมด id = 'user~~index' ({users: [...]})
//
// G05 ความเสี่ยงที่ยอมรับ (เจ้าของระบบเลือกไม่ใช้ Firebase Auth):
//   - เอกสารบัญชีอ่านได้ด้วย config สาธารณะ → salt + hash รหัสผ่านถูกอ่านไปเดาแบบออฟไลน์ได้
//     (แอปใช้ PBKDF2-SHA256 150,000 รอบ = hashVer 3 ทำให้เดาช้าลงมาก แต่ไม่ใช่การป้องกันจริง)
//   - ลายเซ็นเซสชันในเครื่องคำนวณจาก hash ที่อ่านได้ → ปลอมเซสชันได้ (กันได้แค่การแก้ localStorage แบบทั่วไป)
//   - การ update บัญชี (อนุมัติ / ตั้งบทบาท / รีเซ็ตรหัสผ่าน) rules แยกไม่ได้ว่าใครเป็นผู้ดูแล — ใครถือ config ก็ส่งได้
//   ทางแก้จริง = Firebase Authentication (+ custom claims) หรือ Cloud Function สำหรับ login/อนุมัติ, และ App Check
//
// ลำดับการสร้างบัญชีที่ rules นี้รองรับ: สร้างเป็น pending เสมอ (สมัครเอง / ผู้ดูแลเพิ่ม / บัญชีแรก) แล้วจึง update เป็น active
service cloud.firestore {
  match /databases/{db}/documents {

    match /return_cases/{id} {
      function isIndex() { return id == 'user~~index'; }
      function isAcct()  { return id.matches('user~.*') && !isIndex(); }
      function isCase()  { return !id.matches('user~.*'); }
      function caseOk()  { return request.resource.data.keys().hasAny(['invoiceNo', 'orderNo'])
                                  && request.resource.data.status is string; }
      function pwOk()    { return request.resource.data.salt is string
                                  && request.resource.data.pass is string
                                  && request.resource.data.get('hashVer', 2) in [2, 3]; }

      allow read: if true;

      allow create: if (isCase() && caseOk())
                    || (isIndex() && request.resource.data.users is list)
                    // บัญชีใหม่ต้องเป็น pending เสมอ — สร้าง {role:'admin', status:'active'} ตรง ๆ ไม่ได้
                    || (isAcct() && id == 'user~' + request.resource.data.username
                        && request.resource.data.status == 'pending'
                        && request.resource.data.role == 'pending'
                        && request.resource.data.requestedRole in ['sales', 'wh', 'ipqc', 'admin']
                        && pwOk());

      allow update: if (isCase() && caseOk())
                    // รายชื่อบัญชีเพิ่มได้อย่างเดียว ลบชื่อออกไม่ได้
                    || (isIndex() && request.resource.data.users is list
                        && request.resource.data.users.hasAll(resource.data.users))
                    // username / วันสมัคร (acctCreatedAt) เปลี่ยนไม่ได้, บทบาท/สถานะอยู่ในชุดที่กำหนด (rules ตรวจไม่ได้ว่าผู้ส่งเป็นผู้ดูแล — ดู G05)
                    || (isAcct() && request.resource.data.username == resource.data.username
                        && request.resource.data.get('acctCreatedAt', '') == resource.data.get('acctCreatedAt', '')
                        && request.resource.data.status in ['pending', 'active', 'suspended']
                        && request.resource.data.role in ['admin', 'sales', 'wh', 'ipqc', 'pending']
                        && pwOk());

      allow delete: if false;          // เคส: ย้ายไปถังขยะ (deleted:true) · บัญชี: ใช้ "ระงับ" แทนการลบ
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
